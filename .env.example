# Fill OPENAI_API_KEY to generate cited Portuguese answers with the chat model.
# With an empty key, Ask still retrieves Current Articles and uses an extractive draft.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Snapshot date shown in the UI; the in-repo manifest is the source of truth.
CORPUS_CUTOFF=2026-09-18
